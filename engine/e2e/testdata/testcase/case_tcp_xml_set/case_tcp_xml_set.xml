<?xml version="1.0" encoding="UTF-8"?>
<case guid="dc969a76-904f-49cb-88b5-f42e4a834a46"  flags="core" title="TCP-xml_set: 标准BCD前缀XML交互">
  <action>
    <!-- 步骤1: 发送TCP XML请求，验证响应 -->
    <step desc="TCP xml_set 请求">
      <Action type="xml_set" server="TCMOCK" trancode="TRAN001" />
      <value name="/Request/Header/TRAN_CODE">TRAN001</value>
      <value name="/Request/Body/AMOUNT">10000</value>
      <Verify>
        <result name="//resp_code">000000</result>
        <result name="//resp_msg">SUCCESS</result>
        <result name="//balance">50000</result>
      </Verify>
      <save>
        <key name="tcp_resp_code">//resp_code</key>
        <key name="tcp_balance">//balance</key>
      </save>
    </step>

    <!-- 步骤2: 验证提取的变量 -->
    <step desc="验证TCP提取变量-resp_code">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{tcp_resp_code}} == 000000</result>
      </Verify>
    </step>

    <step desc="验证TCP提取变量-balance">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{tcp_balance}} == 50000</result>
      </Verify>
    </step>
  </action>
</case>
