<?xml version="1.0" encoding="UTF-8"?>
<case flags="core" title="Mixed-All: 综合测试(HTTP+TCP+SQL+RSA+Runtime)">
  <setup>
    <!-- SQL: 确认初始数据 -->
    <step desc="SETUP-SQL: 查询用户数">
      <Action type="sql_select" server="TESTDB">SELECT COUNT(*) as cnt FROM users</Action>
      <result name="cnt[0]">3</result>
    </step>

    <!-- HTTP: 健康检查 -->
    <step desc="SETUP-HTTP: 健康检查">
      <Action type="http" server="MOCK" method="GET" api="/health" />
      <Verify>
        <result name="$.status">ok</result>
      </Verify>
    </step>
  </setup>

  <action>
    <!-- 1. HTTP: 创建订单，提取变量 -->
    <step desc="HTTP-创建订单">
      <Action type="http" server="MOCK" method="POST" api="/api/order/create" />
      <header name="Content-Type">application/json</header>
      <body>{"tran_code":"MIXED01","amount":"12345","user_id":"mixed_test"}</body>
      <Verify>
        <result name="$.ret_code">000000</result>
        <result name="$.ret_msg">success</result>
        <result name="$.status">ACTIVE</result>
      </Verify>
      <save>
        <key name="mixed_order_id">$.order_id</key>
        <key name="mixed_amount">$.amount</key>
      </save>
    </step>

    <!-- 2. TCP: xml_set 报文交互 -->
    <step desc="TCP-xml_set 请求">
      <Action type="xml_set" server="TCMOCK" trancode="TRAN002" />
      <value name="/Request/Header/TRAN_CODE">MIXEDT</value>
      <value name="/Request/Body/USER_ID">mixed_user</value>
      <value name="/Request/Body/PRODUCT">E2E_TEST</value>
      <Verify>
        <result name="//RESP_CODE">000000</result>
        <result name="//RESP_MSG">SUCCESS</result>
      </Verify>
      <save>
        <key name="mixed_tcp_resp">//RESP_CODE</key>
        <key name="mixed_tcp_balance">//BALANCE</key>
      </save>
    </step>

    <!-- 3. SQL: 插入并查询 -->
    <step desc="SQL-INSERT">
      <Action type="sql_update" server="TESTDB">INSERT INTO orders (user_id, amount, status) VALUES (1, '{{mixed_amount}}', 'COMPLETED')</Action>
      <Verify>
        <value>*</value>
      </Verify>
    </step>
    <step desc="SQL-SELECT">
      <Action type="sql_select" server="TESTDB">SELECT status, amount FROM orders WHERE user_id = 1 ORDER BY id DESC LIMIT 1</Action>
      <result name="status[0]">COMPLETED</result>
      <result name="amount[0]">12345</result>
      <save>
        <key name="mixed_sql_status">status[0]</key>
      </save>
    </step>

    <!-- 4. RSA: 加密 -->
    <step desc="RSA加密">
      <Action type="rsa"
        key="MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCqGKukO1De7zhZj6+H0qtjTkVxwTCpvKe4eCZ0FPqri0cb2JZfXJ/DgYSF6vUpwmJG8wVQZKroGc0d5Q8H0HbD+3t4A6GrC2WPRh/JRUW8G6m2gBLZp3eC+f+6lCIfBL0SJj8Jmh0s3bXN8UOs5J9+LZJ9q+e5vXcMR/VhrM+nQQIDAQAB"
        value="mixed_e2e_data" />
      <save>
        <key name="mixed_rsa_out"></key>
      </save>
    </step>

    <!-- 5. runtime_verify: 对所有提取变量做最终验证 -->
    <step desc="Runtime-验证order_id">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{mixed_order_id}} == {{mixed_order_id}}</result>
      </Verify>
    </step>
    <step desc="Runtime-验证amount">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{mixed_amount}} == 12345</result>
      </Verify>
    </step>
    <step desc="Runtime-验证TCP变量">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{mixed_tcp_resp}} == 000000</result>
        <result name="">{{mixed_tcp_balance}} == 50000</result>
      </Verify>
    </step>
    <step desc="Runtime-验证SQL变量">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{mixed_sql_status}} == COMPLETED</result>
      </Verify>
    </step>
    <step desc="Runtime-验证RSA非空">
      <Action type="runtime_verify" />
      <Verify>
        <result name="">{{mixed_rsa_out}} == {{mixed_rsa_out}}</result>
      </Verify>
    </step>
  </action>

  <teardown>
    <!-- TEARDOWN: 用HTTP取消订单 -->
    <step desc="TEARDOWN-取消订单">
      <Action type="http" server="MOCK" method="POST" api="/api/order/cancel" />
      <header name="Content-Type">application/json</header>
      <body>{"order_id":"{{mixed_order_id}}"}</body>
      <Verify>
        <result name="$.ret_code">000000</result>
        <result name="$.status">CANCELLED</result>
      </Verify>
    </step>
  </teardown>
</case>
