            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="3验证结果" enabled="true">
              <stringProp name="BeanShellAssertion.query">// assertion
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.apache.jmeter.assertions; 
import org.apache.jmeter.samplers.SampleResult; 
import org.apache.jmeter.assertions.AssertionResult; 
import test.xmlhelper;

log.warn(&quot;Entering sql step 3...&quot;);
String expectedResult = vars.get(&quot;expectedResult&quot;);
String data = Response.getResponseDataAsString();
String[] action = expectedResult.split(&quot;;&quot;);
String colmnName = &quot;&quot;;
String rowIndex = &quot;&quot;;
FailureMessage = &quot;&quot;;
log.info(&quot;expected: &quot;+expectedResult);
log.info(&quot;response: &quot;+data);

if(!expectedResult.equals(&quot;&quot;)){
	for (int num = 0; num &lt; action.length; num++){
		item = action[num].split(&quot;@@@&quot;);
	     tagName = item[0];
	     tagV = item[1];
	
		// 从sql结果中查找对应的值 resultVariable
		colmnName = tagName.split(&quot;\\[|\\]&quot;)[0];
	     rowIndex = tagName.split(&quot;\\[|\\]&quot;)[1];
		temp = vars.getObject(&quot;resultVariable&quot;).get(Integer.parseInt(rowIndex)).get(colmnName);
		
	     if (temp.toString().equals(tagV)){
	     	fail = true;
			log.info(&quot;Result : Pass&quot;);
	     }else
		{
			log.info(&quot;Result : Failed&quot;);
			Failure = true;
			FailureMessage = &quot;[ tag &quot;+tagName+&quot; mismatch ]&quot; + FailureMessage;
			
		}
	}	
}
else{
	log.info(&quot;Nothing to check!&quot;);
}

log.warn(&quot;Leaving sql step 3...&quot;);</stringProp>
