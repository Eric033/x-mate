            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="2 根据用例文件数据参数化" enabled="true">
              <boolProp name="resetInterpreter">true</boolProp>
              <stringProp name="parameters">${template_content} ${test_data}</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">// prepost
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.io.*;
import org.dom4j.Document;
import org.dom4j.DocumentException;
import org.dom4j.io.SAXReader;
import java.io.IOException;
import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.ParserConfigurationException;
import javax.xml.xpath.XPath;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathExpression;
import javax.xml.xpath.XPathExpressionException;
import javax.xml.xpath.XPathFactory;
import org.w3c.dom.Document;
import org.w3c.dom.NodeList;
import org.xml.sax.SAXException;
import test.FindByConf;
import test.xmlhelper;
import test.preProcess;

log.warn(&quot;Entering tcpdamplerset step 2...&quot;);
//模板文件内容
String temp = vars.get(&quot;template_content&quot;);

//测试数据
String input = vars.get(&quot;test_data&quot;);
String[] action = input.split(&quot;;&quot;);


for (int num = 0; num &lt; action.length; num++){
     item = action[num].split(&quot;:&quot;);
     tagName = item[0];
     tagV = item[1];
     
     //vars.put(&quot;tempV&quot;,tagV);
     log.info(tagName+&quot; &quot;+tagV+&quot;    &quot;+${__V(tagV)});
     // 尝试先将尝试将tagV值按照jmeter变量解析

     String jmvalue = &quot;&quot;;
     String dd = &quot;&quot;;

	dd = new preProcess().process(ctx,tagV);
	// 向前兼容
     if(!tagName.startsWith(&quot;/&quot;)){
     	tagName = &quot;//&quot; + tagName;
     }

     temp = new test.xmlhelper().set(tagName,dd,temp);


     
     log.info(&quot;actual : &quot; + dd.trim());
}
// 修改trancode增加@字符

// TODO: 优化
String step_type = vars.get(&quot;step_type&quot;);

if(&quot;tcp_damper_set&quot;.equals(step_type)){
	tempTranCode = new test.xmlhelper().get(&quot;//TRAN_CODE&quot;,temp);
	temp = new test.xmlhelper().set(&quot;//TRAN_CODE&quot;,&quot;@&quot;+tempTranCode,temp);
}
else{
	tempTranCode = new test.xmlhelper().get(&quot;//_TransactionId&quot;,temp);
	temp = new test.xmlhelper().set(&quot;//_TransactionId&quot;,&quot;@&quot;+tempTranCode,temp);
}

log.info(&quot;frame : &quot; +temp);
vars.put(&quot;frame&quot;,temp);
log.warn(&quot;leaving tcpdamplerset step 2...&quot;);</stringProp>
