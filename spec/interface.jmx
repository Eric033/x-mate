              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.util.regex.Matcher;
import java.util.regex.Pattern;
log.warn(&quot;Entering sql step 1...&quot;);

String sqlstr = vars.get(&quot;sqlstr&quot;);
String strMatchNr = vars.get(&quot;paras_matchNr&quot;);
int iMatchNr = Integer.valueOf(strMatchNr);
String varName = &quot;&quot;;
String varValue = &quot;&quot;;
String varRegValue = &quot;&quot;;
String varActValue = &quot;&quot;;
String jmVarValue = &quot;&quot;;

while(iMatchNr &gt; 0){
     varName = &quot;paras_&quot;+String.valueOf(iMatchNr)+&quot;_g1&quot;;
     varValue = vars.get(varName);

     // 添加必要的转义字符
     varRegValue = &quot;\\{\\{&quot;+vars.get(varName)+&quot;\\}\\}&quot;;
     jmVarValue = vars.get(varValue);
     
     // replace
	Pattern pattern = Pattern.compile(varRegValue);
	Matcher matcher = pattern.matcher(sqlstr);
	sqlstr = matcher.replaceFirst(jmVarValue);
     iMatchNr--;
}

vars.put(&quot;sqlstr&quot;,sqlstr);
log.warn(&quot;Leaving sql step 1...&quot;);</stringProp>
            </BeanShellPreProcessor>
