            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion" enabled="false">
              <stringProp name="BeanShellAssertion.query">log.warn(&quot;Entering sql验证 step 4...&quot;);

String result = vars.get(&quot;sqlExpResTrimed_1_g1&quot;);
if(!vars.get(&quot;verify_matchNr&quot;).equals(&quot;0&quot;)){
	if (result.equals(&quot;*&quot;)){
		log.info(&quot;无需验证&quot;);
	}else if(result.equals(vars.get(&quot;sqlActualResult_1&quot;)))
	{
		log.info(&quot;Sql验证通过.&quot;);
	}else{
		Failure = true;
		FailureMessage =&quot;Sql验证失败.&quot;;
	}
}


log.warn(&quot;Leaving 动态验证 step 4...&quot;);</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
