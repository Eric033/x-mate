          <hashTree>
            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="_替换" enabled="false">
              <stringProp name="BeanShellSampler.query">// addition
import java.util.regex.Matcher;
import java.util.regex.Pattern;

String json = vars.get(&quot;httpserverdata&quot;);
log.info(&quot;ment : &quot;+ json);
to = vars.get(vars.get(&quot;ment&quot;)); 
log.info(&quot;to : &quot;+ to);
p = &quot;\\{\\{&quot;+vars.get(&quot;ment&quot;)+&quot;\\}\\}&quot;;

log.info(&quot;p : &quot;+p);
Pattern pattern = Pattern.compile(p);
Matcher matcher = pattern.matcher(json);
json = matcher.replaceFirst(to);
vars.put(&quot;body&quot;,json);</stringProp>
