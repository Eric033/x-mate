String[] action = input.split(&quot;;&quot;);

for (int num = 0; num &lt; action.length; num++){
     item = action[num].split(&quot;:&quot;);
     tagName = item[0];
     tagV = item[1];

     String actualTagV = &quot;&quot;;
     actualTagV = new preProcess().process(ctx,tagV);
     log.info(&quot;set &quot; + tagName + &quot; to &quot; + actualTagV);

	// 向前兼容,
     if(!tagName.startsWith(&quot;/&quot;)){
     	tagName = &quot;//&quot; + tagName;
     }

     template_content = new test.xmlhelper().set(tagName,actualTagV,template_content);
}




log.info(&quot;xmlset sending :&quot; + template_content);
