              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">int i =1;

while(vars.get(&quot;testv_&quot;+String.valueOf(i)) != null){
	vars.remove(&quot;testv_&quot;+String.valueOf(i));
	//log.info(&quot;testv_&quot;+String.valueOf(i)+&quot; found!&quot;);
	i++;
	
}

vars.remove(&quot;setup_1&quot;);
vars.remove(&quot;teardown_1&quot;);
vars.remove(&quot;server_index&quot;);
vars.remove(&quot;resultVariable&quot;);
vars.remove(&quot;sqlActualResult_1&quot;);
