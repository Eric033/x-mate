              <stringProp name="filename"></stringProp>
              <stringProp name="script">log.warn(&quot;Entering 动态验证 step 3...&quot;);

String strMatchNr = vars.get(&quot;paras_matchNr&quot;);
int iMatchNr = Integer.valueOf(strMatchNr);
String expStr = vars.get(&quot;expression&quot;).trim();
String targetStr = &quot;&quot;;
String replaceStr = &quot;&quot;;
String jmVName = &quot;&quot;;
String jmVValue = &quot;&quot;;

while(iMatchNr &gt; 0){
     targetStr = vars.get(&quot;paras_&quot;+String.valueOf(iMatchNr)+&quot;_g0&quot;);
     jmVName = vars.get(&quot;paras_&quot;+String.valueOf(iMatchNr)+&quot;_g1&quot;);
     jmVValue = vars.get(jmVName);

     // replace targetStr with jmVValue
     log.info(&quot;targetStr : &quot; + targetStr);
     log.info(&quot;jmVValue : &quot; + jmVValue);
     expStr=expStr.replace(targetStr,jmVValue);
     iMatchNr--;
}

log.info(&quot;exp : &quot; + expStr);
vars.put(&quot;expression&quot;,expStr);
log.warn(&quot;Leaving 动态验证 step 3...&quot;);</stringProp>
