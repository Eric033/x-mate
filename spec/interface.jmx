            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="预处理预期结果" enabled="false">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">// 从用例配置文件获取预期结果
strMatchNr = vars.get(&quot;xml_set_results_matchNr&quot;);
iMatchNr = Integer.valueOf(strMatchNr);
String resultdata = &quot;&quot;;

while(iMatchNr &gt; 0){

     resultdata= resultdata + vars.get(&quot;xml_set_results_&quot;+String.valueOf(iMatchNr));
     iMatchNr--;
     if(iMatchNr != 0)
     {
     	resultdata = resultdata + &quot;;&quot;;
     }
}
     
log.info(&quot;expectedResult :&quot;+resultdata);
vars.put(&quot;expectedResult&quot;,resultdata);</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="0添加头querystring" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import org.apache.jmeter.protocol.http.control.HeaderManager;
import org.apache.jmeter.protocol.http.control.Header;
import org.apache.jmeter.testelement.property.CollectionProperty;
import test.preProcess;

import org.apache.commons.lang3.StringEscapeUtils;
import org.apache.jmeter.protocol.http.util.HTTPArgument;

log.warn(&quot;Entering http step 0...&quot;);

// 添加 queryString
int idx = Integer.parseInt(vars.get(&quot;queryStrings_matchNr&quot;));
//queryStrings_3_g1

for (int i = 1 ; i &lt;idx +1 ; i++ ) {
     String index_str = String.valueOf(i);
     String result = new preProcess().process(ctx,vars.get(&quot;queryStrings_&quot;+index_str+&quot;_g2&quot;));
     log.info(&quot;queryStrings key :&quot;+vars.get(&quot;queryStrings_&quot;+index_str+&quot;_g1&quot;));
	log.info(&quot;queryStrings v :&quot;+result);
     arg = new HTTPArgument(vars.get(&quot;queryStrings_&quot;+index_str+&quot;_g1&quot;), result);
     
     if(result.contains(&quot;#&quot;)){
     	arg.setAlwaysEncoded(false);
     }

	sampler.getArguments().addArgument(arg);
} 

idx = Integer.parseInt(vars.get(&quot;headers_matchNr&quot;));

// 添加 headers

HeaderManager headerManager = sampler.getHeaderManager();

int n = headerManager.size();
for(int i = 0; i &lt; n; i++){
	headerManager.remove(0);
}

for (int i = 1 ; i &lt;idx +1 ; i++ ) {
     String index_str = String.valueOf(i);
     String result = new preProcess().process(ctx,vars.get(&quot;headers_&quot;+index_str+&quot;_g2&quot;));
	log.info(&quot;headers key :&quot;+vars.get(&quot;headers_&quot;+index_str+&quot;_g1&quot;));
	log.info(&quot;headers v :&quot;+StringEscapeUtils.unescapeHtml4(result));
	headerManager.add(new Header(vars.get(&quot;headers_&quot;+index_str+&quot;_g1&quot;),StringEscapeUtils.unescapeHtml4(result)));
} 

// 处理body
vars.put(&quot;body&quot;,new preProcess().process(ctx,vars.get(&quot;body&quot;)));

log.warn(&quot;Leaving http step 0...&quot;);
</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="1 校验结果" enabled="true">
              <stringProp name="BeanShellAssertion.query">import org.apache.jmeter.samplers.SampleResult; 
import org.apache.jmeter.assertions.AssertionResult; 
import test.jsonhelper;
import test.xmlhelper;

log.warn(&quot;Entering http step 1...&quot;);

String expectedResult = vars.get(&quot;httpresultstr&quot;);
String bodydata = SampleResult.getResponseDataAsString();
String data = &quot;&quot;;
log.info(&quot;expected: &quot;+expectedResult);
log.info(&quot;response body: &quot;+data);
log.info(&quot;response headers: &quot;+ResponseHeaders);

String[] action = expectedResult.split(&quot;;&quot;);
FailureMessage = &quot;&quot;;
String temp;

if(expectedResult != &quot;VERIFY_NOT_FOUND&quot;){
	for (int num = 0; num &lt; action.length; num++){
		item = action[num].split(&quot;@@@&quot;);
	     tagName = item[0];
	     isHeader = item[1];
	     headerName = item[2];
	     tagV = item[3];	
		log.info(tagName);
		log.info(isHeader);
		log.info(headerName);
		log.info(tagV);
		log.info(&quot;action[num]: &quot;+action[num]);
		
		if (isHeader.equals(&quot;True&quot;)){
		// 验证header信息
		     String kvStr=&quot;&quot;;
			headers=ResponseHeaders.split(&quot;\\n&quot;);

			for(int headern=0; headern &lt; headers.length;headern++){
				if(headers[headern].startsWith(headerName)){
					kvStr = headers[headern].split(&quot;: &quot;)[1];
					break;
				}
			}

			data = kvStr;
			
		}else{
	     // 验证body
               data = bodydata;
		}

		// 比对结果
		if(tagName.startsWith(&quot;$&quot;)){
			log.info(&quot;json&quot;);
			temp = new jsonhelper().get(data,tagName).trim();
		}else{
			log.info(&quot;xml&quot;);
			temp = new test.xmlhelper().get(tagName,data).trim();
		}
		
		if (temp.equals(tagV) || tagName.equals(&quot;&quot;)){
			fail = true;
			log.info(&quot;Result : Pass&quot;);
		}else
		{
			log.info(&quot;Result : Failed&quot;);
			Failure = true;
			FailureMessage = &quot;[ tag &quot;+tagName+&quot; mismatch ]&quot; + FailureMessage;
		}

	}
}
else{
	log.info(&quot;Nothing to check!&quot;);
}


log.warn(&quot;Leaving http step 1...&quot;);</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
