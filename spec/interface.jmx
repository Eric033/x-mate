                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">log.info(&quot;Saving &quot; + vars.get(&quot;sqlpath&quot;));
String temp = &quot;&quot;;
String rowIndex = &quot;&quot;;
String colmnName = &quot;&quot;;
if(!vars.get(&quot;sqlpath&quot;).trim().equals(&quot;&quot;)){
	colmnName = vars.get(&quot;sqlpath&quot;).split(&quot;\\[|\\]&quot;)[0];
	rowIndex = vars.get(&quot;sqlpath&quot;).split(&quot;\\[|\\]&quot;)[1];
}

log.info(&quot;c :&quot;+colmnName);
log.info(&quot;r :&quot;+rowIndex);

if(vars.get(&quot;sqlpath&quot;).trim()==&quot;&quot;){
	// 向前兼容,如果name为空字符串，则默认使用第一行第一列
	temp = vars.get(&quot;sqlActualResult_1&quot;);
}
else if(Integer.parseInt(rowIndex) &gt; vars.getObject(&quot;resultVariable&quot;).size()){
	temp = &quot;sqlpathNotFound&quot;; 
}
else{	
		temp = vars.getObject(&quot;resultVariable&quot;).get(Integer.parseInt(rowIndex)).get(colmnName).toString();
}

log.info(&quot;key : &quot;+vars.get(&quot;keyName&quot;).trim()+&quot;, value : &quot; + temp);
vars.put(vars.get(&quot;keyName&quot;).trim(),temp.trim());</stringProp>
