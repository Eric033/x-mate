              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="预处理预期结果数据" enabled="true">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">String resultdata;
String resultname = vars.get(&quot;resultname&quot;);
String isHeader = vars.get(&quot;isHeader&quot;);
String headerName = vars.get(&quot;headerName&quot;);
String resultvalue = vars.get(&quot;resultvalue&quot;);

if(&quot;VERIFY_NOT_FOUND&quot; == vars.get(&quot;httpresultstr&quot;)){
	resultdata = &quot;&quot;;
}
else{
	resultdata = vars.get(&quot;httpresultstr&quot;);
}

resultdata = resultdata + resultname.trim() + &quot;@@@&quot; + isHeader.trim() + &quot;@@@&quot; + headerName.trim() + &quot;@@@&quot; + resultvalue.trim() +&quot;;&quot;;

vars.put(&quot;httpresultstr&quot;,resultdata);</stringProp>
