                <stringProp name="filename"></stringProp>
                <stringProp name="script">import test.preProcess;
import test.jsonhelper;

String locator = vars.get(&quot;locator&quot;).trim();
String target = new preProcess().process(ctx,vars.get(&quot;target&quot;));
String varname = vars.get(&quot;varname&quot;).trim();
String result = &quot;&quot;;

if(locator.startsWith(&quot;//&quot;)){
	// xpath
	result = &quot;XPATH_RUNTIME_SAVE_NOT_IMPLENTED&quot;;
}
else if(locator.startsWith(&quot;$&quot;)){
	// jpath
	log.info(target+&quot;  &quot;+locator);
	result = new jsonhelper().get(target,locator);
}
else{
	// regular expression
	result = &quot;REX_RUNTIME_SAVE_NOT_IMPLENTED&quot;;
}

log.info(&quot;saving &quot; + varname +&quot; : &quot;+result);
vars.put(varname,result);</stringProp>
