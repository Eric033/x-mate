          <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="打印步骤信息" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.util.Date; 
import java.text.SimpleDateFormat;  

Date ss = new Date();  
SimpleDateFormat format0 = new SimpleDateFormat(&quot;ddHHmmssS&quot;);  
String time = format0.format(ss.getTime());
String seq_str = vars.get(&quot;date_str_6&quot;)+
			  time.substring(time.length()-9,time.length())+
			  &quot;00&quot;;

String seq_str_1 = vars.get(&quot;date_str_6&quot;).substring(2)+
			  time.substring(time.length()-9,time.length())+
			  &quot;00&quot;;
String seq_str_2 = vars.get(&quot;time_str_6&quot;);	

vars.put(&quot;seq_no&quot;,seq_str);
vars.put(&quot;seq_no_pay&quot;,seq_str_1);
vars.put(&quot;time_no&quot;,seq_str_2);
vars.remove(&quot;frame&quot;);

log.info(&quot;====================&quot;);
log.info(vars.get(&quot;desc&quot;));
log.info(&quot;====================&quot;);

vars.put(&quot;serverIP&quot;,vars.get(&quot;server_&quot;+vars.get(&quot;server_index&quot;)));
vars.put(&quot;serverPort&quot;,vars.get(&quot;port_&quot;+vars.get(&quot;server_index&quot;)));




</stringProp>
          </BeanShellPostProcessor>
