            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="1 获取测试数据" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">true</boolProp>
              <stringProp name="script">// data
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.io.*;
import org.dom4j.Document;
import org.dom4j.DocumentException;
import org.dom4j.io.SAXReader;


log.warn(&quot;Entering xmlset step 1...&quot;);

// 从用例配置文件获取请求报文数据
String strMatchNr = vars.get(&quot;xml_set_values_matchNr&quot;);
int iMatchNr = Integer.valueOf(strMatchNr);
String testdata = &quot;&quot;;

while(iMatchNr &gt; 0){
     testdata = testdata + vars.get(&quot;xml_set_values_&quot;+String.valueOf(iMatchNr));
     iMatchNr--;
     if(iMatchNr != 0)
     {
     	testdata = testdata + &quot;;&quot;;
     }
}
log.info(&quot;testdata :&quot;+testdata);
vars.put(&quot;test_data&quot;,testdata);

// 从用例配置文件获取预期结果
strMatchNr = vars.get(&quot;xml_set_results_matchNr&quot;);
iMatchNr = Integer.valueOf(strMatchNr);
String resultdata = &quot;&quot;;

while(iMatchNr &gt; 0){
     resultdata= resultdata + vars.get(&quot;xml_set_results_&quot;+String.valueOf(iMatchNr));
     iMatchNr--;
     if(iMatchNr != 0)
     {
     	resultdata = resultdata + &quot;;&quot;;
     }
}
        
log.info(&quot;expectedResult :&quot;+resultdata);
vars.put(&quot;expectedResult&quot;,resultdata);
log.warn(&quot;leaving xmlset step 1...&quot;);</stringProp>
            </BeanShellPreProcessor>
            <hashTree/>
            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="2 根据用例文件数据参数化" enabled="true">
              <boolProp name="resetInterpreter">true</boolProp>
              <stringProp name="parameters">${template_content} ${test_data}</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import test.xmlhelper;
import test.preProcess;

log.warn(&quot;Entering xmlset step 2...&quot;);
//模板文件内容
String template_content = vars.get(&quot;template_content&quot;);

//测试数据
String input = vars.get(&quot;test_data&quot;);
String[] action = input.split(&quot;;&quot;);

for (int num = 0; num &lt; action.length; num++){
     item = action[num].split(&quot;:&quot;);
     tagName = item[0];
     tagV = item[1];

     String actualTagV = &quot;&quot;;
