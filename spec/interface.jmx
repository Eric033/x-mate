            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="3 验证结果" enabled="true">
              <stringProp name="BeanShellAssertion.query">// assertion
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import org.apache.jmeter.assertions; 
import org.apache.jmeter.samplers.SampleResult; 
import org.apache.jmeter.assertions.AssertionResult; 
import test.xmlhelper;

log.warn(&quot;Entering tcpdamperset step 3...&quot;);
String expectedResult = vars.get(&quot;expectedResult&quot;);

String data = Response.getResponseDataAsString();
//String expectedResult = &quot;abc:2;def:4&quot;;
String[] action = expectedResult.split(&quot;;&quot;);
//String data = &quot;&lt;abc&gt;0&lt;/abc&gt;  &lt;def&gt;4&lt;/def&gt;&quot;;
FailureMessage = &quot;&quot;;
log.info(&quot;expected: &quot;+expectedResult);
log.info(&quot;response: &quot;+data);

// TODO: 优化
String step_type = vars.get(&quot;step_type&quot;);
String temp = &quot;&quot;;

for (int num = 0; num &lt; action.length; num++){
	item = action[num].split(&quot;@@@&quot;);
     tagName = item[0];
     tagV = item[1];

	// 向前兼容
     if(!tagName.startsWith(&quot;/&quot;)){
     	tagName = &quot;//&quot; + tagName;
     }


	if(&quot;tcp_damper_set&quot;.equals(step_type)){
		temp = new test.xmlhelper().get(tagName,data.substring(6)).trim();
	}
	else{
		temp = new test.xmlhelper().get(tagName,data.substring(0,data.length()-2)).trim();
	}
	
     if (temp.equals(tagV)){
     	fail = true;
		log.info(&quot;pass&quot;);
     }else
	{
		log.info(&quot;failed&quot;);
		Failure = true;
		FailureMessage = &quot;[ tag &quot;+tagName+&quot; mismatch ]&quot; + FailureMessage;
		
	}
}

log.warn(&quot;Leaving tcpdamperset step 3...&quot;);</stringProp>
