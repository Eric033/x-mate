              <stringProp name="script">import test.preProcess;
vars.put(&quot;httpserverapi&quot;,new preProcess().process(ctx,vars.get(&quot;httpserverapi&quot;)));

if(vars.get(&quot;step_type&quot;).equals(&quot;damper_set&quot;))
{
