<root>
	<preActions>	
		<Action type="xml_setting" tag = "TRAN_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "SERVICE_CODE">
			<value type = "string">
			SVR_INQUIRY
			</value>
		</Action>
	</preActions>
	<case id = "0001" tittle = "020306_001" trancode = "020306" flag = "core full">
		<step desc="步骤1">
			<Action type="sql_exe">
				<value>
					SELECT START_NO FROM ensemble.tb_voucher_trailbox_info WHERE doc_type='215' and TRAILBOX_ID='410401018' AND STATUS='NUS'
				</value>
			</Action>
			<Verify>
				<value>
					*
				</value>
			</Verify>
			<save>
				<key name="">
				   START_NO
				</key>
			</save>
		</step>
		<step desc="步骤1">
			<Action type="xml_set" trancode = "020306">
				<value name="CCY">
					CNY
				</value>
				<value name="NEW_VOUCHER_NO">
					{{START_NO}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		</case>
</root>