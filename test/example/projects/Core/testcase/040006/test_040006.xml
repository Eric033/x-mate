<root>
	<preActions>
		<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "TRAN_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "SERVICE_CODE">
			<value type = "string">
			SVR_FINANCIAL
			</value>
		</Action>
	</preActions>
	<case id = "0001" tittle = "040006" trancode = "040006" flag = "core full">
		<step desc="步骤2">
			<Action type="xml_set" trancode = "010130_1">
				<value name="DEP_CARD_NO">
					6210355030000180890
				</value>
				<value name="BASE_ACCT_NO">
					6210355030000180890
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤3交易行账务记账1">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=1 and gl.branch='{{case_branch_id}}'  and gl.gl_code='300101' 
				</value>
			</Action>
			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
		<step desc="步骤4交易行账务记账2">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=-1 and gl.branch='{{case_branch_id}}'  and gl.gl_code='300101' 
				</value>
			</Action>
			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode = "040006_1" >
				<value name="//Body/CHANNEL_SEQ_NO">
				   {{case_seqno}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno1
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id1
				</key>
			</save>
		</step>
	</case>
</root>