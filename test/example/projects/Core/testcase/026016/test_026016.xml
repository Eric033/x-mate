<root>
<preActions>
	<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "TRAN_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>		
	<Action type="xml_setting" tag = "SERVICE_CODE">
		<value type = "string">
			SVR_FINANCIAL
		</value>
	</Action>
</preActions>
<case id = "0001" tittle = "026016_001" trancode = "026016" flag = "core full">
		<step desc="步骤1">
			<Action type="sql_exe">
				<value>
					select CARD_NO from ensemble.cd_card_arch where  PRODUCT_ID='04' AND CUST_NO='1019103827' AND CARD_STATE='2'
				</value>
			</Action>
			<Verify>
				<value>
					*
				</value>
			</Verify>
			<save>
				<key name="">
				   CARD_NO1
				</key>
			</save>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode = "026016">
				<value name="CARD_NO">
					{{CARD_NO1}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
</case>
</root>