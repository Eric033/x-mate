<case id = "0001" tittle = "020844小额免密免签开关设置开通" trancode = "020844" flag = "core full">
		<step desc="步骤1">
			<Action type="xml_set" trancode="020844">
			    <value name="//Body/CARD_NO">
					6231383960000035098
				</value>
				<value name="//Body/NOPWD_OPTION">
					0
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
				<key name="//Body/CLIENT_NO">
				    client_no
				</key>
				<key name="//Body/CARD_NO">
				    card_no
				</key>
			</save>
		</step>
		<step desc="步骤2开通是否成功">
			<Action type="sql_exe" >
				<value>
				   select CCA.IS_NOPWD_FLAG from ensemble.cd_card_arch cca where card_no='6231383960000035098'
				</value>
			</Action>
			<Verify>
				<value>
                  Y
				</value>
			</Verify>
		</step>
		<step desc="步骤3关闭">
			<Action type="xml_set" trancode="020844">
			    <value name="//Body/CARD_NO">
					6231383960000035098
				</value>
				<value name="//Body/NOPWD_OPTION">
					1
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
		</step>
</case>
