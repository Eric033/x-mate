		<step desc="步骤3开户行账务">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=-0.05 and gl.branch='410102'  and gl.gl_code='201401' 
