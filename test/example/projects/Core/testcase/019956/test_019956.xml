<root>
	<preActions>	
		<Action type="xml_setting" tag = "TRAN_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "SERVICE_CODE">
			<value type = "string">
			SVR_FINANCIAL
			</value>
		</Action>
	</preActions>
	<case id = "0001" tittle = "019956_001" trancode = "019956" flag = "core full">
        <step desc="步骤3">	
			<Action type="xml_set" trancode = "010101">
				<value name="//Sys_Head/USER_ID">
					000151
				</value>
				<value name="//Sys_Head/BRANCH_ID">
					419999
				</value>
				<value name="//Sys_Head/SOURCE_TYPE">
					MT
				</value>
				<value name="//POST_DATE">
					{{CurrentDate_1}}
				</value>
				<value name="//EFFECT_DATE">
					{{CurrentDate_1}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤3">	
			<Action type="xml_set" trancode = "019956">
				<value name="//CCY">
					CNY
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤4交易行账务">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=0.01 and gl.branch='{{case_branch_id}}'  and gl.gl_code='100101' 
				</value>
			</Action>
			<Verify>
				<value>
                  0
				</value>
			</Verify>
		</step>
		<step desc="步骤5开户行账务">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=-0.01 and gl.branch='411529' and  gl.gl_code='201401'
				</value>
			</Action>
			<Verify>
				<value>
                  0
				</value>
			</Verify>
		</step>
	</case>
</root>