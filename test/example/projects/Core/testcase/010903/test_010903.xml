<root>
<preActions>
	<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>
    <Action type="xml_setting" tag = "EFFECT_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "TRAN_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "SERVICE_CODE">
		<value type = "string">
			SVR_FINANCIAL
		</value>
	</Action>
</preActions>
<case id = "0001" tittle = "010903" trancode = "010903" flag = "core full">
		<step desc="步骤1">
			<Action type="xml_set" trancode = "050104">
				<value name="BASE_ACCT_NO">
					0080018821700000010
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="/Reply_Msg/Body/ACCT_ARRAY/Row/LEDGER_BAL">
				   LEDGER_BAL1
				</key>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode="010903">
				<value name="//Body/GL_ARRAY/Row[2]/BASE_ACCT_NO">
					0080018821700000010
				</value>
				<value name="//Body/GL_ARRAY/Row[1]/BASE_ACCT_NO">
					0050011896500000010
				</value>
				<value name="//EFFECT_DATE">
					{{CurrentDate_1}}
				</value>
				<value name="//BU_SETTLEMENT_DATE">
					{{CurrentDate_1}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤3">
			<Action type="xml_set" trancode = "050104">
				<value name="BASE_ACCT_NO">
					0080018821700000010
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="/Reply_Msg/Body/ACCT_ARRAY/Row/LEDGER_BAL">
				   LEDGER_BAL2
				</key>
			</save>
		</step>
		<step desc="动态验证">
			<Action type="runtime_verify">
			</Action>
			<Verify>
				<result name = "result">
					{{LEDGER_BAL1}}+1.00=={{LEDGER_BAL2}}
				</result>
			</Verify>
		</step>
		<step desc="步骤3交易行账务记账1">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=-1 and gl.branch='{{case_branch_id}}' and gl.gl_code='300101' 
				</value>
			</Action>
			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
         <step desc="步骤4开户行账务记账2">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=1 and gl.branch='411012'  and gl.gl_code='201401'
				</value>
			</Action>
			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
</case>
</root>