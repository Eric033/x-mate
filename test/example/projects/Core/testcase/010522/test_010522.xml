<root>
<preActions>
	<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "TRAN_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "SERVICE_CODE">
		<value type = "string">
			SVR_FINANCIAL
		</value>
	</Action>
</preActions>
<case id = "0001" tittle = "010522_001" trancode = "010522" flag = "core full">
		<step desc="步骤1">
			<Action type="xml_set" trancode = "050104">
				<value name="BASE_ACCT_NO">
					410105010110000809
				</value>
				<value name="ACCT_TYPE">
					201
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="/Reply_Msg/Body/ACCT_ARRAY/Row/LEDGER_BAL">
				   LEDGER_BAL1
				</key>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode = "010522">
				<value name="BASE_ACCT_NO">
					410105010170000703
				</value>
				<value name="SUB_ACCT_NO">
					410105010110000809
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤3">
			<Action type="xml_set" trancode = "050104">
				<value name="BASE_ACCT_NO">
					410105010110000809
				</value>
				<value name="ACCT_TYPE">
					201
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="/Reply_Msg/Body/ACCT_ARRAY/Row/LEDGER_BAL">
				   LEDGER_BAL2
				</key>
			</save>
		</step>
		<step desc="动态验证">
			<Action type="runtime_verify">
			</Action>
			<Verify>
				<result name = "result">
					{{LEDGER_BAL1}}+3.00=={{LEDGER_BAL2}}
				</result>
			</Verify>
		</step>
		<step desc="步骤3账务记账1">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=3 and gl.branch='410105'  and gl.gl_code='201201' 
				</value>
			</Action>
			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
         <step desc="步骤4账务记账2">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=-3 and gl.branch='419999' and client_no='419905'  and gl.gl_code='300101'
				</value>
			</Action>
			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
</case>
</root>