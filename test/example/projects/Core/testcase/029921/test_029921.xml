<root>
	<preActions>	
		<Action type="xml_setting" tag = "TRAN_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "SERVICE_CODE">
			<value type = "string">
			SVR_INQUIRY
			</value>
		</Action>
	</preActions>
	<case id = "0001" tittle = "029921_001" trancode = "029921" flag = "core full">
		<step desc="步骤1">
			<Action type="xml_set" trancode = "029920">
				<value name="OPTION">
					A
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
				<key name="/Reply_Msg/Body/CTRL_ID">
				   ctrl_id
				</key>
			</save>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode = "029921">
				<value name="OPTION_KW">
					C
				</value>
				<value name="CTRL_ID">
					{{ctrl_id}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
	</case>
</root>