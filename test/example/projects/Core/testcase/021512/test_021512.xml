<case id = "0001" tittle = "021512银承挂失" trancode = "021512" flag = "core full">
		<step desc="步骤1">
			<Action type="xml_set" trancode="021512">
			   <value name="//Body/OPTIONS">
					01
				</value>
				<value name="//Body/SOURCE_REFERENCE">
					4199992015050800007602
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
				<key name="//Body/SOURCE_REFERENCE">
					source_reference
				</key>
				<key name="//Body/REFERENCE">
					reference
				</key>
				
			</save>
		</step>
		<step desc="步骤2挂失是否成功">
			<Action type="sql_exe" >
				<value>
				   select count(*) from ensemble.ad_lost_msg where reference='{{reference}}' and status='2'
