			<Verify>
				<value>
                  1
				</value>
			</Verify>
		</step>
		<step desc="步骤3解挂">
			<Action type="xml_set" trancode="021512">
			   <value name="//Body/OPTIONS">
					02
				</value>
				<value name="//Body/SOURCE_REFERENCE">
					4199992015050800007602
				</value>
				<value name="//Body/REFERENCE">
					{{reference}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
