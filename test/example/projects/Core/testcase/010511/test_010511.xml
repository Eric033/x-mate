<root>
<preActions>
	<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "TRAN_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>		
	<Action type="xml_setting" tag = "SERVICE_CODE">
		<value type = "string">
			SVR_FINANCIAL
		</value>
	</Action>
</preActions>
<case id = "0001" tittle = "010511_001" trancode = "010511" flag = "core full">
		<step desc="步骤2">
			<Action type="xml_set" trancode = "050512">
				<value name="BASE_ACCT_NO">
					526010054912011
				</value>
				<value name="SUB_ACCT_NO">
					0008
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
			<key name="/Reply_Msg/Body/TRAN_ARRAY/Row/SUB_ACCT_BAL">
				   SUB_ACCT_BAL1
				</key>
			</save>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode = "010511">
				<value name="BASE_ACCT_NO">
					526010054912011
				</value>
				<value name="BUDGET_DEPARTMENT">
					0008
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id
				</key>
			</save>
		</step>
		<step desc="步骤2">
			<Action type="xml_set" trancode = "050512">
				<value name="BASE_ACCT_NO">
					526010054912011
				</value>
				<value name="SUB_ACCT_NO">
					0008
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
			<key name="/Reply_Msg/Body/TRAN_ARRAY/Row/SUB_ACCT_BAL">
				   SUB_ACCT_BAL2
				</key>
			</save>
		</step>
		<step desc="动态验证">
			<Action type="runtime_verify">
			</Action>
			<Verify>
				<result name = "result">
					{{SUB_ACCT_BAL1}}-1.00=={{SUB_ACCT_BAL2}}
				</result>
			</Verify>
		</step>
		<step desc="步骤3交易行账务记账1">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=-1 and gl.branch='{{case_branch_id}}' and gl.client_no=gl.branch and gl.gl_code='224101' 
				</value>
			</Action>
			<Verify>
				<value>
                  0
				</value>
			</Verify>
		</step>
		<step desc="步骤4开户行账务记账2">
			<Action type="sql_exe" >
				<value>
				  select count(*) from ensemble.gl_post_today gl where  gl.reference='{{case_seqno}}' and gl.amount=1 and gl.branch='411004' and gl.client_no=gl.branch and gl.gl_code='201401' 
				</value>
			</Action>
			<Verify>
				<value>
                  0
				</value>
			</Verify>
		</step>
</case>
</root>