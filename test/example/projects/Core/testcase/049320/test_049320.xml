<root>
	<preActions>
		<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "TRAN_DATE">
			<value type = "date">
			now.YYYYMMDD
			</value>
		</Action>	
		<Action type="xml_setting" tag = "SERVICE_CODE">
			<value type = "string">
			SVR_FINANCIAL
			</value>
		</Action>
	</preActions>
	<case id = "0001" tittle = "049320" trancode = "049320" flag = "core full">
		<step desc="步骤1">
			<Action type="xml_set" trancode = "019302" >
				<value name="//BATCH_DATE">
				{{CurrentDate_1}}
				</value> 
				<value name="//VALUE_DATE">
				{{CurrentDate_1}}
				</value> 
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno1
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id1
				</key>
			</save>
		</step>

		<step desc="步骤2">
			<Action type="xml_set" trancode = "049320" >
				<value name="//Body/REFERENCE">
				   {{case_seqno1}}
				</value>
				<value name="//Body/TRAN_ARRAY/Row/REFERENCE">
				   {{case_seqno1}}
				</value>
			</Action>
			<Verify>
				<result name = "RET_CODE">
					000000
				</result>
			</Verify>
			<save>
				<key name="//Sys_Head/SEQ_NO">
				   case_seqno2
				</key>
				<key name="//Sys_Head/BRANCH_ID">
				   case_branch_id2
				</key>
			</save>
		</step>
	</case>
</root>