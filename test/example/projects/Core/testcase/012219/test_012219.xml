<root>
<preActions>
	<Action type="xml_setting" tag = "BU_SETTLEMENT_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>	
	<Action type="xml_setting" tag = "TRAN_DATE">
		<value type = "date">
			now.YYYYMMDD
		</value>
	</Action>		
	<Action type="xml_setting" tag = "SERVICE_CODE">
		<value type = "string">
			SVR_FINANCIAL
		</value>
	</Action>
</preActions>
<case id = "0001" tittle = "012219_001" trancode = "012219" flag = "core full">
